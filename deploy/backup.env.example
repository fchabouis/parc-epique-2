# Copy to `backup.env` on the server. restic encrypts and deduplicates the
# backups and speaks to many storages (SFTP, S3, Backblaze B2...), see
# https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html
# The storage must NOT be on the server being backed up.
RESTIC_REPOSITORY=sftp:user@backup-host:/backups/parc-epique
RESTIC_PASSWORD=

# Backblaze B2 instead of SFTP: a private bucket and an application key
# limited to it, then
#   RESTIC_REPOSITORY=b2:bucket-name:/
#   B2_ACCOUNT_ID=<keyID>
#   B2_ACCOUNT_KEY=<applicationKey>

# Optional: URL pinged after each successful backup (healthchecks.io for
# example), which alerts when the backup stops running.
HEALTHCHECK_PING_URL=
