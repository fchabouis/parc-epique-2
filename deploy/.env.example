# Copy to `.env` on the server (never commit the real one) and fill it in.
# Passwords are put in a URL: use letters and digits only, for example
#   openssl rand -hex 24

# Domain served by Caddy
PHX_HOST=parc-epique.fr

POSTGRES_USER=parc_epique
POSTGRES_PASSWORD=
POSTGRES_DB=parc_epique

# openssl rand -hex 64
SECRET_KEY_BASE=

# Image to run (built and pushed by the "Deploy" workflow)
APP_IMAGE=ghcr.io/fchabouis/parc-epique-2:latest

# Sign-in with Google (optional: the button is hidden when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
